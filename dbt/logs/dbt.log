  create  table "airflow"."analytics_mart"."fct_hourly_errors"
  
  
    as
  
  (
    

-- Observations to the right grain (and incremental-friendly)
with obs as (
  select
    city,
    valid_time,
    temperature_2m::numeric as temp_c,
    precipitation::numeric  as precip_mm
  from "airflow"."analytics_staging"."stg_observations"
  
),

-- Pick the latest forecast for each (city, valid_time) by model_run
latest_fcst as (
  select
    city,
    valid_time,
    model_run,
    temperature_2m::numeric as temp_c_forecast,
    precipitation::numeric  as precip_mm_forecast
  from (
    select
      city,
      valid_time,
      model_run,
      temperature_2m,
      precipitation,
      row_number() over (
        partition by city, valid_time
        order by model_run desc
      ) as rn
    from "airflow"."analytics_staging"."stg_forecasts"
  ) f
  where rn = 1
)

select
  o.city,
  o.valid_time,
  o.temp_c,
  o.precip_mm,
  f.model_run,
  f.temp_c_forecast,
  f.precip_mm_forecast,
  abs(f.temp_c_forecast - o.temp_c)       as abs_temp_err,
  abs(f.precip_mm_forecast - o.precip_mm) as abs_precip_err
from obs o
left join latest_fcst f
  on  f.city       = o.city
  and f.valid_time = o.valid_time
  );
  
  
