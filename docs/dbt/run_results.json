failures": null, "unique_id": "test.weather_lab.dbt_utils_unique_combination_of_columns_stg_observations_city__valid_time.3812616f84", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        city, valid_time\n    from \"airflow\".\"analytics_staging\".\"stg_observations\"\n    group by city, valid_time\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:32:07.452615Z", "completed_at": "2025-08-18T18:32:07.459084Z"}, {"name": "execute", "started_at": "2025-08-18T18:32:07.460670Z", "completed_at": "2025-08-18T18:32:07.460676Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.021263599395751953, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_observations_city.82496b7b7b", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_observations\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:32:07.463219Z", "completed_at": "2025-08-18T18:32:07.472260Z"}, {"name": "execute", "started_at": "2025-08-18T18:32:07.476778Z", "completed_at": "2025-08-18T18:32:07.476789Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.016510486602783203, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_observations_valid_time.43830f9520", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect valid_time\nfrom \"airflow\".\"analytics_staging\".\"stg_observations\"\nwhere valid_time is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:32:07.466779Z", "completed_at": "2025-08-18T18:32:07.477496Z"}, {"name": "execute", "started_at": "2025-08-18T18:32:07.478616Z", "completed_at": "2025-08-18T18:32:07.478622Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.01603531837463379, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.weather_lab.fct_hourly_errors", "compiled": true, "compiled_code": "-- depends_on: \"airflow\".\"analytics_staging\".\"stg_observations\"\n-- depends_on: \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n\n\n\nwith obs as (\n  select city, valid_time, temp_c, precip_mm\n  from \"airflow\".\"analytics_staging\".\"stg_observations\"\n  \n    where valid_time > (\n      select coalesce(max(valid_time), '1900-01-01'::timestamptz) from \"airflow\".\"analytics_mart\".\"fct_hourly_errors\"\n    )\n  \n),\nlatest_fcst as (\n  select *\n  from (\n    select\n      city,\n      valid_time,\n      model_run,\n      temp_c_forecast,\n      precip_mm_forecast,\n      row_number() over (\n        partition by city, valid_time\n        order by model_run desc\n      ) as rn\n    from \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n  ) f\n  where rn = 1\n)\n\nselect\n  o.city,\n  o.valid_time,\n  o.temp_c,\n  o.precip_mm,\n  f.model_run,\n  f.temp_c_forecast,\n  f.precip_mm_forecast,\n  abs(f.temp_c_forecast - o.temp_c)        as abs_temp_err,\n  abs(f.precip_mm_forecast - o.precip_mm)  as abs_precip_err\nfrom obs o\nleft join latest_fcst f\n  on  f.city = o.city\n  and f.valid_time = o.valid_time", "relation_name": "\"airflow\".\"analytics_mart\".\"fct_hourly_errors\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:32:07.472549Z", "completed_at": "2025-08-18T18:32:07.478347Z"}, {"name": "execute", "started_at": "2025-08-18T18:32:07.479529Z", "completed_at": "2025-08-18T18:32:07.479536Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.016677379608154297, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_city.7c2476eeb4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:32:07.474675Z", "completed_at": "2025-08-18T18:32:07.478984Z"}, {"name": "execute", "started_at": "2025-08-18T18:32:07.480294Z", "completed_at": "2025-08-18T18:32:07.480302Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.014919281005859375, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_model_run.eea4bedb72", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect model_run\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere model_run is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:32:07.481983Z", "completed_at": "2025-08-18T18:32:07.485249Z"}, {"name": "execute", "started_at": "2025-08-18T18:32:07.492125Z", "completed_at": "2025-08-18T18:32:07.492134Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.012934446334838867, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_cities_city.b077ab056e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_cities\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:32:07.485513Z", "completed_at": "2025-08-18T18:32:07.494313Z"}, {"name": "execute", "started_at": "2025-08-18T18:32:07.495342Z", "completed_at": "2025-08-18T18:32:07.495349Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.01402735710144043, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.unique_stg_cities_ci