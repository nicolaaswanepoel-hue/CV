failures": null, "unique_id": "test.weather_lab.dbt_utils_unique_combination_of_columns_stg_observations_city__valid_time.3812616f84", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        city, valid_time\n    from \"airflow\".\"analytics_staging\".\"stg_observations\"\n    group by city, valid_time\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T19:45:53.673599Z", "completed_at": "2025-08-20T19:45:53.679346Z"}, {"name": "execute", "started_at": "2025-08-20T19:45:53.680591Z", "completed_at": "2025-08-20T19:45:53.680596Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01832723617553711, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_observations_city.82496b7b7b", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_observations\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T19:45:53.682788Z", "completed_at": "2025-08-20T19:45:53.690909Z"}, {"name": "execute", "started_at": "2025-08-20T19:45:53.695071Z", "completed_at": "2025-08-20T19:45:53.695085Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.014807701110839844, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_observations_valid_time.43830f9520", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect valid_time\nfrom \"airflow\".\"analytics_staging\".\"stg_observations\"\nwhere valid_time is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T19:45:53.685891Z", "completed_at": "2025-08-20T19:45:53.695567Z"}, {"name": "execute", "started_at": "2025-08-20T19:45:53.696483Z", "completed_at": "2025-08-20T19:45:53.696489Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.01425480842590332, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.weather_lab.fct_hourly_errors", "compiled": true, "compiled_code": "-- depends_on: \"airflow\".\"analytics_staging\".\"stg_observations\"\n-- depends_on: \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n\n\n\nwith obs as (\n  select city, valid_time, temp_c, precip_mm\n  from \"airflow\".\"analytics_staging\".\"stg_observations\"\n  \n    where valid_time > (\n      select coalesce(max(valid_time), '1900-01-01'::timestamptz) from \"airflow\".\"analytics_mart\".\"fct_hourly_errors\"\n    )\n  \n),\nlatest_fcst as (\n  select *\n  from (\n    select\n      city,\n      valid_time,\n      model_run,\n      temp_c_forecast,\n      precip_mm_forecast,\n      row_number() over (\n        partition by city, valid_time\n        order by model_run desc\n      ) as rn\n    from \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n  ) f\n  where rn = 1\n)\n\nselect\n  o.city,\n  o.valid_time,\n  o.temp_c,\n  o.precip_mm,\n  f.model_run,\n  f.temp_c_forecast,\n  f.precip_mm_forecast,\n  abs(f.temp_c_forecast - o.temp_c)        as abs_temp_err,\n  abs(f.precip_mm_forecast - o.precip_mm)  as abs_precip_err\nfrom obs o\nleft join latest_fcst f\n  on  f.city = o.city\n  and f.valid_time = o.valid_time", "relation_name": "\"airflow\".\"analytics_mart\".\"fct_hourly_errors\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T19:45:53.691185Z", "completed_at": "2025-08-20T19:45:53.696153Z"}, {"name": "execute", "started_at": "2025-08-20T19:45:53.697322Z", "completed_at": "2025-08-20T19:45:53.697328Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.014833688735961914, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_city.7c2476eeb4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T19:45:53.693066Z", "completed_at": "2025-08-20T19:45:53.696843Z"}, {"name": "execute", "started_at": "2025-08-20T19:45:53.698006Z", "completed_at": "2025-08-20T19:45:53.698012Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.013297557830810547, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_model_run.eea4bedb72", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect model_run\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere model_run is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T19:45:53.699498Z", "completed_at": "2025-08-20T19:45:53.706089Z"}, {"name": "execute", "started_at": "2025-08-20T19:45:53.708507Z", "completed_at": "2025-08-20T19:45:53.708514Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.011482954025268555, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_cities_city.b077ab056e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_cities\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T19:45:53.703171Z", "completed_at": "2025-08-20T19:45:53.710274Z"}, {"name": "execute", "started_at": "2025-08-20T19:45:53.711266Z", "completed_at": "2025-08-20T19:45:53.711272Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.012367486953735352, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.unique_stg_cities_ci