r_response": {}, "message": null, "failures": null, "unique_id": "model.weather_lab.dim_city", "compiled": true, "compiled_code": "\nselect distinct city from \"airflow\".\"analytics_staging\".\"stg_observations\"", "relation_name": "\"airflow\".\"analytics_mart\".\"dim_city\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:56:19.837933Z", "completed_at": "2025-08-18T18:56:19.849379Z"}, {"name": "execute", "started_at": "2025-08-18T18:56:19.850864Z", "completed_at": "2025-08-18T18:56:19.850870Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.016680240631103516, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_city.7c2476eeb4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:56:19.853672Z", "completed_at": "2025-08-18T18:56:19.867909Z"}, {"name": "execute", "started_at": "2025-08-18T18:56:19.870677Z", "completed_at": "2025-08-18T18:56:19.870684Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.019480228424072266, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.weather_lab.fct_hourly_errors", "compiled": true, "compiled_code": "-- depends_on: \"airflow\".\"analytics_staging\".\"stg_observations\"\n-- depends_on: \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n\n\n\nwith obs as (\n  select city, valid_time, temp_c, precip_mm\n  from \"airflow\".\"analytics_staging\".\"stg_observations\"\n  \n    where valid_time > (\n      select coalesce(max(valid_time), '1900-01-01'::timestamptz) from \"airflow\".\"analytics_mart\".\"fct_hourly_errors\"\n    )\n  \n),\nlatest_fcst as (\n  select *\n  from (\n    select\n      city,\n      valid_time,\n      model_run,\n      temp_c_forecast,\n      precip_mm_forecast,\n      row_number() over (\n        partition by city, valid_time\n        order by model_run desc\n      ) as rn\n    from \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n  ) f\n  where rn = 1\n)\n\nselect\n  o.city,\n  o.valid_time,\n  o.temp_c,\n  o.precip_mm,\n  f.model_run,\n  f.temp_c_forecast,\n  f.precip_mm_forecast,\n  abs(f.temp_c_forecast - o.temp_c)        as abs_temp_err,\n  abs(f.precip_mm_forecast - o.precip_mm)  as abs_precip_err\nfrom obs o\nleft join latest_fcst f\n  on  f.city = o.city\n  and f.valid_time = o.valid_time", "relation_name": "\"airflow\".\"analytics_mart\".\"fct_hourly_errors\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:56:19.860036Z", "completed_at": "2025-08-18T18:56:19.871179Z"}, {"name": "execute", "started_at": "2025-08-18T18:56:19.872256Z", "completed_at": "2025-08-18T18:56:19.872263Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01950216293334961, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.dbt_utils_unique_combination_of_columns_stg_observations_city__valid_time.3812616f84", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        city, valid_time\n    from \"airflow\".\"analytics_staging\".\"stg_observations\"\n    group by city, valid_time\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-18T18:56:19.865874Z", "completed_at": "2025-08-18T18:56:19.871829Z"}, {"name": "execute", "started_at": "2025-08-18T18:56:19.873216Z", "completed_at": "2025-08-18T18:56:19.873224Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.020242691040039062, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_observations_city.82496b7b7b"