ilures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_city.7c2476eeb4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T08:53:54.260411Z", "completed_at": "2025-08-20T08:53:54.266106Z"}, {"name": "execute", "started_at": "2025-08-20T08:53:54.271979Z", "completed_at": "2025-08-20T08:53:54.271984Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.02126932144165039, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_model_run.eea4bedb72", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect model_run\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere model_run is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T08:53:54.266675Z", "completed_at": "2025-08-20T08:53:54.273325Z"}, {"name": "execute", "started_at": "2025-08-20T08:53:54.274239Z", "completed_at": "2025-08-20T08:53:54.274245Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.009529590606689453, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.weather_lab.fct_hourly_errors", "compiled": true, "compiled_code": "-- depends_on: \"airflow\".\"analytics_staging\".\"stg_observations\"\n-- depends_on: \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n\n\n\nwith obs as (\n  select city, valid_time, temp_c, precip_mm\n  from \"airflow\".\"analytics_staging\".\"stg_observations\"\n  \n    where valid_time > (\n      select coalesce(max(valid_time), '1900-01-01'::timestamptz) from \"airflow\".\"analytics_mart\".\"fct_hourly_errors\"\n    )\n  \n),\nlatest_fcst as (\n  select *\n  from (\n    select\n      city,\n      valid_time,\n      model_run,\n      temp_c_forecast,\n      precip_mm_forecast,\n      row_number() over (\n        partition by city, valid_time\n        order by model_run desc\n      ) as rn\n    from \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n  ) f\n  where rn = 1\n)\n\nselect\n  o.city,\n  o.valid_time,\n  o.temp_c,\n  o.precip_mm,\n  f.model_run,\n  f.temp_c_forecast,\n  f.precip_mm_forecast,\n  abs(f.temp_c_forecast - o.temp_c)        as abs_temp_err,\n  abs(f.precip_mm_forecast - o.precip_mm)  as abs_precip_err\nfrom obs o\nleft join latest_fcst f\n  on  f.city = o.city\n  and f.valid_time = o.valid_time", "relation_name": "\"airflow\".\"analytics_mart\".\"fct_hourly_errors\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T08:53:54.274787Z", "completed_at": "2025-08-20T08:53:54.284369Z"}, {"name": "execute", "started_at": "2025-08-20T08:53:54.285102Z", "completed_at": "2025-08-20T08:53:54.285109Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01238393783569336, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.dbt_utils_unique_combination_of_columns_stg_observations_city__valid_time.3812616f84", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        city, valid_time\n    from \"airflow\".\"analytics_staging\".\"stg_observations\"\n    group by city, valid_time\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-20T08:53:54.280549Z", "completed_at": "2025-08-20T08:53:54.285461Z"}, {"name": "execute", "started_at": "2025-08-20T08:53:54.286393Z", "completed_at": "2025-08-20T08:53:54.286399Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.01291656494140625, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_observations_city.82496b7b7b", "