ted_at": "2025-08-19T12:29:28.791547Z", "completed_at": "2025-08-19T12:29:28.791565Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.026204347610473633, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.weather_lab.fct_hourly_errors", "compiled": true, "compiled_code": "-- depends_on: \"airflow\".\"analytics_staging\".\"stg_observations\"\n-- depends_on: \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n\n\n\nwith obs as (\n  select city, valid_time, temp_c, precip_mm\n  from \"airflow\".\"analytics_staging\".\"stg_observations\"\n  \n    where valid_time > (\n      select coalesce(max(valid_time), '1900-01-01'::timestamptz) from \"airflow\".\"analytics_mart\".\"fct_hourly_errors\"\n    )\n  \n),\nlatest_fcst as (\n  select *\n  from (\n    select\n      city,\n      valid_time,\n      model_run,\n      temp_c_forecast,\n      precip_mm_forecast,\n      row_number() over (\n        partition by city, valid_time\n        order by model_run desc\n      ) as rn\n    from \"airflow\".\"analytics_staging\".\"stg_forecasts\"\n  ) f\n  where rn = 1\n)\n\nselect\n  o.city,\n  o.valid_time,\n  o.temp_c,\n  o.precip_mm,\n  f.model_run,\n  f.temp_c_forecast,\n  f.precip_mm_forecast,\n  abs(f.temp_c_forecast - o.temp_c)        as abs_temp_err,\n  abs(f.precip_mm_forecast - o.precip_mm)  as abs_precip_err\nfrom obs o\nleft join latest_fcst f\n  on  f.city = o.city\n  and f.valid_time = o.valid_time", "relation_name": "\"airflow\".\"analytics_mart\".\"fct_hourly_errors\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-19T12:29:28.782759Z", "completed_at": "2025-08-19T12:29:28.790389Z"}, {"name": "execute", "started_at": "2025-08-19T12:29:28.792419Z", "completed_at": "2025-08-19T12:29:28.792428Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.022241830825805664, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_city.7c2476eeb4", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-19T12:29:28.786185Z", "completed_at": "2025-08-19T12:29:28.792106Z"}, {"name": "execute", "started_at": "2025-08-19T12:29:28.793734Z", "completed_at": "2025-08-19T12:29:28.793742Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.02287912368774414, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_forecasts_model_run.eea4bedb72", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect model_run\nfrom \"airflow\".\"analytics_staging\".\"stg_forecasts\"\nwhere model_run is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-19T12:29:28.795859Z", "completed_at": "2025-08-19T12:29:28.807712Z"}, {"name": "execute", "started_at": "2025-08-19T12:29:28.812154Z", "completed_at": "2025-08-19T12:29:28.812166Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.01933574676513672, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.not_null_stg_cities_city.b077ab056e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect city\nfrom \"airflow\".\"analytics_staging\".\"stg_cities\"\nwhere city is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-08-19T12:29:28.800007Z", "completed_at": "2025-08-19T12:29:28.812610Z"}, {"name": "execute", "started_at": "2025-08-19T12:29:28.813948Z", "completed_at": "2025-08-19T12:29:28.813957Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.019160747528076172, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.weather_lab.unique_stg_cities_cit